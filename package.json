{
  "name": "known-universe-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser 3D space exploration set in the Dune universe (CS373IA Computer Graphics & VR)",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch --env-file-if-exists=server/.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.6.14",
    "lil-gui": "^0.19.2",
    "postprocessing": "^6.36.4",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.171.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-glsl": "^1.3.1",
    "vitest": "^5.1.1"
  }
}
