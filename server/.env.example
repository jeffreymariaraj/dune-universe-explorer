# Copy to server/.env and fill in. server/.env is gitignored: the key must never
# reach the browser or the repository.
#
# Any OpenAI-compatible endpoint works (SYSTEM_DESIGN.md section 2). Examples:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Day 9: Groq is the default, so this one line is enough:
GROQ_API_KEY=

# Optional overrides (any OpenAI-compatible provider that supports tool calls):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# Optional. Vite's dev proxy expects 8787 (see vite.config.ts).
PORT=8787
